{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreBinaries": ["graphify", "wasm-pack"],
  // The design gallery is tooling, not application code. Skill runtimes no longer
  // need an entry here: .gitignore keeps them out of the tree knip walks.
  "ignore": ["apps/web/.impeccable/**"],
  "workspaces": {
    "apps/web": {
      // Second Vite HTML entry: the RAWM diagnostic page. index.html is detected.
      "entry": ["src/diagnostico.tsx"],
    },
    "packages/core-wasm": {
      // @gearhub/core is a Cargo path dependency, never a JS import: the edge exists
      // only so turbo's task graph sees packages/core/src and invalidates the wasm
      // build's dependents on a Rust-only change. knip only sees JS/TS imports, so
      // it reads this as unused — it is not.
      "ignoreDependencies": ["@gearhub/core"],
    },
  },
}
