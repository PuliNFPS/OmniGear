{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreBinaries": ["graphify", "wasm-pack"],
  // The design gallery is tooling, not application code. Skill runtimes no longer
  // need an entry here: .gitignore keeps them out of the tree knip walks.
  "ignore": ["apps/web/.impeccable/**"],
  "workspaces": {
    "apps/web": {
      // Second Vite HTML entry: the read-only RAWM probe. index.html is detected.
      "entry": ["src/diagnostico.tsx"],
    },
    "packages/core-wasm": {
      // @gearhub/core is a Cargo path dependency, never a JS import: the edge exists
      // only so turbo's task graph sees packages/core/src and invalidates the wasm
      // build's dependents on a Rust-only change. knip only sees JS/TS imports, so
      // it reads this as unused — it is not.
      "ignoreDependencies": ["@gearhub/core"],
    },
  },
  "ignoreIssues": {
    // Skeleton kept for the upcoming WebHID implementation.
    "apps/web/src/hardware/WebHidTransport.ts": ["files"],
    // Public while the store API is still being shaped.
    "apps/web/src/store/deviceStore.ts": ["types"],
    // Test utility: interfaces exported for conformance vector tests.
    "apps/web/src/test/vectors.ts": ["types"],
    // Part of the brief's public interface for Task 2; used inside this file
    // today, and by UI surfaces that show RAWM failures in later tasks.
    "apps/web/src/core/rawmError.ts": ["exports"],
  },
}
