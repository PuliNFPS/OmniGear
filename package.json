{
  "name": "gearhub",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm core:prepare && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write . && pnpm --filter @gearhub/core format",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "audit:ts": "knip",
    "audit:boundaries": "depcruise --config .dependency-cruiser.cjs apps/web/src packages/ui/src packages/shared/src",
    "audit:rust": "node scripts/run-rust-tool.mjs audit",
    "audit": "pnpm audit:ts && pnpm audit:boundaries && pnpm audit:rust",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm run audit",
    "graph:index": "graphify extract . --code-only --cargo && graphify cluster-only .",
    "graph:update": "pnpm graph:index",
    "graph:status": "graphify check-update .",
    "graph:query": "graphify query",
    "core:build": "pnpm --filter @gearhub/core build:wasm",
    "core:prepare": "node scripts/prepare-core.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "18.2.0",
    "knip": "6.32.2",
    "prettier": "^3.6.2",
    "turbo": "^2.10.11",
    "typescript": "5.9.3"
  }
}
